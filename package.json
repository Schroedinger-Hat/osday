{
  "name": "osday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "next dev --turbopack",
    "dev:rage": "rm -rf .next && npm run db:push && next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "sanity:pipeline": "cd src/sanity && npm run sanity:schema && npm run sanity:types",
    "sanity:schema": "cd src/sanity && sanity schema extract",
    "sanity:types": "cd src/sanity && sanity typegen generate",
    "search:standalone": "tsx src/app/api/algolia/reindex/standalone-reindex.ts"
  },
  "dependencies": {
    "@algolia/client-search": "^5.24.0",
    "@next/third-parties": "16.2.4",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-visually-hidden": "^1.1.2",
    "@sanity/code-input": "^7.1.0",
    "@sanity/color-input": "^6.0.3",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^1.4.0",
    "@sanity/vision": "^5.22.0",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@tanstack/react-query": "^5.50.0",
    "@trpc/client": "^11.0.0-rc.446",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.0.0-rc.446",
    "@vercel/speed-insights": "^1.2.0",
    "algoliasearch": "^4.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.4.1",
    "geist": "^1.3.0",
    "hugeicons-react": "0.3.0",
    "instantsearch.js": "^4.85.2",
    "lucide-react": "^0.475.0",
    "next": "16.2.4",
    "next-sanity": "^12.2.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hotkeys-hook": "^5.0.1",
    "react-instantsearch": "^7.16.3",
    "sanity": "^5.22.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.161.0",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.19.4",
    "typescript": "^5.5.3"
  },
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  },
  "packageManager": "npm@10.5.0",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
